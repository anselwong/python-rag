APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag
EMBEDDING_PROVIDER=dashscope
DASHSCOPE_API_KEY=请填写百炼_API_Key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1536
LLM_PROVIDER=deepseek
LLM_API_KEY=请填写模型_API_Key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# 调用前预算使用本地 tiktoken；账单级准确值仍以 LLM 响应 usage 为准。
TOKENIZER_ENCODING=cl100k_base
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=120
HISTORY_TOKEN_BUDGET=1200
MAX_CONTEXT_TOKENS=3000
LLM_CONTEXT_WINDOW=8192
LLM_OUTPUT_RESERVE_TOKENS=1024
PROMPT_FORMAT_OVERHEAD_TOKENS=64
RERANK_PROVIDER=dashscope
RERANK_API_KEY=请填写百炼_API_Key
RERANK_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-api/v1
RERANK_MODEL=qwen3-rerank
